# Copy to .env for local development. Never commit real secrets.
DJANGO_SETTINGS_MODULE=config.settings.local
DJANGO_SECRET_KEY=dev-only-not-a-secret
DATABASE_URL=postgres://propman:propman@db:5432/propman
REDIS_URL=redis://redis:6379/0
ALLOWED_HOSTS=localhost,127.0.0.1

# Payments (sandbox). Each provider webhook is HMAC-signed with this secret.
PAYMENTS_WEBHOOK_SECRET=dev-webhook-secret
